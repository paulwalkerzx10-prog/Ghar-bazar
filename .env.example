# ==========================================
# Frontend Variables (Vite - Client Side)
# ==========================================
# (No specific VITE_ vars currently required for the base app, but add them here if needed later)

# ==========================================
# Backend Variables (Node/Express - Server Side)
# ==========================================
# Port for the Node.js server to run on (defaults to 3000)
PORT=3000

# ==========================================
# PostgreSQL Database Variables (Required for Backend)
# ==========================================
SQL_HOST="your-database-host.render.com"
SQL_USER="your_db_username"
SQL_PASSWORD="your_db_password"
SQL_DB_NAME="your_db_name"

# ==========================================
# API & Third-Party Secrets (Required for Backend)
# ==========================================
# Firebase configuration is read from firebase-applet-config.json
